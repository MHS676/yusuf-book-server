generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  category    String?
  subCategory String?
  cover       String?
  createdAt   DateTime @default(now())
  pages       Page[]
}

model Page {
  id         String @id @default(cuid())
  content    String
  pageNumber Int
  bookId     String
  book       Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, pageNumber])
}
